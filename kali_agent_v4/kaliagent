@cli.command()
def doctor():
    """Run health checks and diagnostics"""
    console.print("[bold green]🔧 Running diagnostics...[/bold green]\n")

    import subprocess, socket

    checks = []

    # Python version
    checks.append(("Python version", f"✅ {sys.version.split()[0]}"))

    # Dependencies
    try:
        import flask
        import rich
        import click
        deps_ok = True
    except ImportError:
        deps_ok = False
    checks.append(("Dependencies", "✅ All installed" if deps_ok else "❌ Missing deps"))

    # Dashboard port
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    result = sock.connect_ex(('127.0.0.1', 5007))
    sock.close()
    checks.append(("Dashboard port", "✅ 5007 available" if result != 0 else "⚠️  5007 in use"))

    # Redis
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    result = sock.connect_ex(('127.0.0.1', 6379))
    sock.close()
    checks.append(("Redis", "✅ Running" if result == 0 else "❌ Not running"))

    # Ollama
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    result = sock.connect_ex(('127.0.0.1', 11434))
    sock.close()
    checks.append(("Ollama", "✅ Running" if result == 0 else "⚠️  Not running"))

    table = Table(show_header=True, header_style="bold cyan")
    table.add_column("Check", style="cyan")
    table.add_column("Status", style="green")

    for check, status in checks:
        table.add_row(check, status)

    console.print(table)
    all_ok = all("✅" in s for _, s in checks)
    if all_ok:
        console.print("\n[green]✅ All checks passed![/green]")
    else:
        console.print("\n[yellow]⚠️  Some checks failed — run docker-compose up -d to start services[/yellow]")


