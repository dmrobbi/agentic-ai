# Demo API Server Dockerfile
# Standalone mock API for dashboard testing

FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application + the package api_server.py imports
# (api_server.py does `from agentic_ai.infrastructure.utils import utcnow`)
COPY api_server.py .
COPY agentic_ai/ ./agentic_ai/

# Expose port
EXPOSE 8080

# Run demo API server
CMD ["python", "api_server.py"]
