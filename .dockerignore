# Keep Docker build contexts small: `COPY . .` in Dockerfile and
# Dockerfile.demo was shipping ~511MB (tracked node_modules, venvs, caches).
.git
.gitignore
.mypy_cache
.pytest_cache
**/__pycache__
**/*.pyc
**/node_modules
dashboard/dist
dashboard/dist.tar.gz
dashboard_v2/frontend/dist
venv
venv-pptx
.venv
data
logs
docs/presentations
docs/papers_stsgym
examples
benchmarks
tests
*.md
!README.md
.claude
.openclaw